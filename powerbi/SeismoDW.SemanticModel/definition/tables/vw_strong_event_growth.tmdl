table vw_strong_event_growth
	lineageTag: 70207267-b92f-57a9-8f8a-f40cc2d18e4d

	measure 'Strong M5+ last year (same period)' = SUM ( vw_strong_event_growth[strong_prev_ytd] )
		formatString: #,0
		lineageTag: 759e35ef-593b-5cf9-b529-0003f130c507

	measure 'Strong M5+ this year (to date)' = SUM ( vw_strong_event_growth[strong_curr_ytd] )
		formatString: #,0
		lineageTag: 372b26c9-c90f-502a-961b-46272815c422

	column location_label
		dataType: string
		lineageTag: 962e3455-5ce0-52f5-ae77-9b15e2f59548
		summarizeBy: none
		sourceColumn: location_label

	column location_type
		dataType: string
		lineageTag: 5271db11-ed0e-58eb-8ad8-5da7e40046bf
		summarizeBy: none
		sourceColumn: location_type

	column strong_prev_ytd
