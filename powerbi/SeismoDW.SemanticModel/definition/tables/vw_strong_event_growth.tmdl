		summarizeBy: sum
		sourceColumn: strong_prev_ytd

	column strong_curr_ytd
		dataType: int64
		formatString: #,0
		lineageTag: 32611649-95cf-547a-877c-b2cd5505d0aa
		summarizeBy: sum
		sourceColumn: strong_curr_ytd

	column growth_pct
		dataType: double
		formatString: 0.0
		lineageTag: f49daf13-e7f7-5000-903c-5b100f4bac71
		summarizeBy: none
		sourceColumn: growth_pct

	column is_material
		dataType: boolean
		lineageTag: e5f00842-8054-5657-8e4e-f854f218517d
		summarizeBy: none
		sourceColumn: is_material

	partition vw_strong_event_growth = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database(PgServer, PgDatabase),
					Nav = Source{[Schema="project_reporting", Item="vw_strong_event_growth"]}[Data],
					Kept = Table.SelectColumns(Nav, {"location_label", "location_type", "strong_prev_ytd", "strong_curr_ytd", "growth_pct", "is_material"})
				in
					Kept
