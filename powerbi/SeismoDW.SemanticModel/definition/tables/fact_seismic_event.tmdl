table fact_seismic_event
	lineageTag: 7b9d02c6-5d40-5648-9ea1-98bc32023f89

	/// Orders KPI equivalent: number of seismic events
	measure 'Total Events' = COUNTROWS ( fact_seismic_event )
		formatString: #,0
		lineageTag: c4844efd-8ee0-554c-9597-b29ada1715f8

	/// Revenue KPI equivalent: radiated energy in kilotons of TNT
	measure 'Energy Released (kt TNT)' = DIVIDE ( SUM ( fact_seismic_event[energy_tnt_tons] ), 1000 )
		formatString: #,0
		lineageTag: 266221bb-e278-58e4-9f68-3f79f340912b

	/// Customers KPI equivalent: distinct countries / US states with events
	measure 'Affected Locations' = DISTINCTCOUNT ( fact_seismic_event[location_key] )
		formatString: #,0
		lineageTag: 2515f4d5-0851-51db-811a-547de6435d12

	measure 'Avg Magnitude' = AVERAGE ( fact_seismic_event[magnitude] )
		formatString: 0.00
		lineageTag: 8b6abdba-4b78-5736-8aac-4206eff74acb

	measure 'Max Magnitude' = MAX ( fact_seismic_event[magnitude] )
		formatString: 0.0
		lineageTag: 28c7af1c-8ba1-5581-a43f-e1b7f32c3687

	measure 'Strong Events (M5+)' = CALCULATE ( [Total Events], fact_seismic_event[magnitude] >= 5 )
		formatString: #,0
		lineageTag: 16379f6f-bd01-5031-b15c-31f4ff65bb52

	measure 'Felt Reports' = SUM ( fact_seismic_event[felt_reports] )
		formatString: #,0
		lineageTag: 3cb81ceb-a56b-5ca7-a2d6-f38298eda0b4

	/// Events in the latest year to date vs the same calendar window one year earlier
	measure 'Events YoY % (same period)' =
			VAR lastDay = CALCULATE ( MAX ( dim_date[full_date] ), fact_seismic_event )
			VAR y = YEAR ( lastDay )
			VAR cur = CALCULATE ( [Total Events], DATESBETWEEN ( dim_date[full_date], DATE ( y, 1, 1 ), lastDay ) )
			VAR prev = CALCULATE ( [Total Events], DATESBETWEEN ( dim_date[full_date], DATE ( y - 1, 1, 1 ), EDATE ( lastDay, -12 ) ) )
			RETURN DIVIDE ( cur - prev, prev )
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: c3b06f85-973b-5390-8794-d1d12499409a

	/// M5+ events in the latest year to date vs the same calendar window one year earlier
	measure 'Strong Events YoY % (same period)' =
			VAR lastDay = CALCULATE ( MAX ( dim_date[full_date] ), fact_seismic_event )
			VAR y = YEAR ( lastDay )
			VAR cur = CALCULATE ( [Strong Events (M5+)], DATESBETWEEN ( dim_date[full_date], DATE ( y, 1, 1 ), lastDay ) )
			VAR prev = CALCULATE ( [Strong Events (M5+)], DATESBETWEEN ( dim_date[full_date], DATE ( y - 1, 1, 1 ), EDATE ( lastDay, -12 ) ) )
			RETURN DIVIDE ( cur - prev, prev )
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 277d69c0-45de-5ec9-8011-529d03a550eb

	measure 'Strong Event Share' = DIVIDE ( [Strong Events (M5+)], [Total Events] )
		formatString: 0.00%
		lineageTag: 9d872287-9862-5bfe-9cc4-89ce09063611

