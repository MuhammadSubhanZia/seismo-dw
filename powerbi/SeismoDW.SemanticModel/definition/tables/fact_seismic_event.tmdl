	partition fact_seismic_event = m
		mode: import
		source =
				let
					Source = PostgreSQL.Database(PgServer, PgDatabase),
					Nav = Source{[Schema="project_dw", Item="fact_seismic_event"]}[Data],
					Active = Table.SelectRows(Nav, each [is_active] = true),
					Kept = Table.SelectColumns(Active, {"event_id", "date_key", "location_key", "network_key", "magnitude_type_key", "event_type_key", "magnitude_class_key", "depth_class_key", "event_hour_utc", "latitude", "longitude", "magnitude", "depth_km", "energy_tnt_tons", "felt_reports", "significance", "alert_level", "tsunami_flag", "is_significant"})
				in
					Kept
