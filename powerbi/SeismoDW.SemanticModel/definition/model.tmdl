model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["PgServer", "PgDatabase", "fact_seismic_event", "dim_date", "dim_location", "dim_network", "dim_magnitude_class", "dim_event_type", "dim_depth_class", "vw_monthly_sales", "vw_customer_analysis", "vw_product_performance", "vw_strong_event_growth", "Decisions"]

ref table fact_seismic_event
ref table dim_date
ref table dim_location
ref table dim_network
ref table dim_magnitude_class
ref table dim_event_type
ref table dim_depth_class
ref table vw_monthly_sales
ref table vw_customer_analysis
ref table vw_product_performance
ref table vw_strong_event_growth
ref table Decisions

ref cultureInfo en-US
