{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.4.0/schema.json",
  "name": "segChart",
  "position": {
    "x": 440,
    "y": 390,
    "z": 7000,
    "height": 320,
    "width": 410,
    "tabOrder": 7000
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "vw_customer_analysis"
                    }
                  },
                  "Property": "activity_segment"
                }
              },
              "queryRef": "vw_customer_analysis.activity_segment",
              "nativeQueryRef": "activity_segment"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "vw_customer_analysis"
                    }
                  },
                  "Property": "Segment Locations"
                }
              },
              "queryRef": "vw_customer_analysis.Segment Locations",
              "nativeQueryRef": "Segment Locations"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Customer segmentation: locations per activity segment'"
                }
              }
            },
            "fontColor": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#17375E'"
                    }
                  }
                }
              }
            },
            "bold": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}